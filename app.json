{
  "expo": {
    "name": "Cahuín",
    "slug": "cahuin",
    "scheme": "cahuin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/icon.jpg",
    "splash": {
      "image": "./src/assets/icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#C0392B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.cahuin.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.jpg",
        "backgroundColor": "#C0392B"
      },
      "package": "cl.cahuin.app"
    },
    "extra": {
      "eas": {
        "projectId": "590fdbce-bdba-4d11-ae89-fa596b09567e"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cahuín usa tu ubicación para mostrarte gente y panoramas cerca de ti."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9649235284758114~7121383056",
          "iosAppId": "ca-app-pub-9649235284758114~7121383056",
          "userTrackingUsageDescription": "Esta app utiliza tu identificador para ofrecerte anuncios personalizados."
        }
      ]
    ]
  }
}
