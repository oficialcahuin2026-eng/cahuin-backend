{
  "expo": {
    "name": "Cahuín",
    "slug": "cahuin",
    "scheme": "cahuin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/icon.png",
    "splash": {
      "image": "./src/assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C0392B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.cahuin.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon.png",
        "backgroundColor": "#C0392B"
      },
      "package": "cl.cahuin.app"
    },
    "extra": {
      "eas": {
        "projectId": "590fdbce-bdba-4d11-ae89-fa596b09567e"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}
